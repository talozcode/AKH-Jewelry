# Copy this file to .env.local and fill in real values. .env.local is
# gitignored - never commit real secrets. See CLAUDE.md for the full
# story behind each of these; this file is just the checklist.

# Supabase project (Settings -> API in the Supabase dashboard)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Not read by any code path today - kept for parity with the dashboard's
# own key pair. Safe to leave blank.
SUPABASE_PUBLISHABLE_KEY=

# Admin login password for /admin (the owner types this in at /admin/login)
ADMIN_TOKEN=

# Stripe - TEST MODE key while developing. STRIPE_WEBHOOK_SECRET can only
# be obtained once the webhook route is deployed and registered against a
# real HTTPS URL in the Stripe Dashboard - see CLAUDE.md's
# "Checkout / payments" section for the full sequencing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Encrypts the Stripe credentials the owner can paste into
# /admin/site-settings (AES-256-GCM, see src/lib/crypto/secrets.ts).
# Generate once with: openssl rand -base64 32
# Static - never needs to change once set, must match on every environment
# that decrypts a value encrypted under it (local + Vercel).
SETTINGS_ENCRYPTION_KEY=
